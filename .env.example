# OpenAI API Key (Required for AI-powered features)
OPENAI_API_KEY=your_openai_api_key_here


# Service-to-service API key (Required)
# Every Python service requires an X-API-Key header matching this value on
# all routes except /health. The orchestrator sends the same key when calling
# sibling services. Use a long random string; services fail closed (401) when
# it is unset.
FUNNEL_API_KEY=change-me-to-a-long-random-string

# MongoDB root credentials (Required)
# Used to create the root user on first initialization of an empty data
# volume, and by all services to connect. Use a long random password.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-password

# Redis password (Required)
REDIS_PASSWORD=change-me-to-a-long-random-password

# MongoDB Connection (authenticated; authSource=admin for the root user)
MONGODB_URI=mongodb://admin:change-me-to-a-long-random-password@localhost:27017/traffic_funnel?authSource=admin

# Redis Connection (authenticated)
REDIS_URL=redis://:change-me-to-a-long-random-password@localhost:6379

# Allowed CORS origins for the Node backend (comma-separated).
# Default: http://localhost:3000. A "*" value allows any origin but disables
# credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000

# Gumroad Integration
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Social Media API Keys (Optional - for automated posting)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# Service URLs (for internal communication)
CONTENT_SERVICE_URL=http://localhost:8001
EMAIL_SERVICE_URL=http://localhost:8003
LEAD_SERVICE_URL=http://localhost:8002
CONVERSION_SERVICE_URL=http://localhost:8004
GUMROAD_SERVICE_URL=http://localhost:8005
TRAFFIC_SERVICE_URL=http://localhost:8006

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
