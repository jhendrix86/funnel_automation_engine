# OpenAI API Key (Required for AI-powered features)
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017

# Redis Connection
REDIS_URL=redis://localhost:6379

# Gumroad Integration
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Social Media API Keys (Optional - for automated posting)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# Service URLs (for internal communication)
CONTENT_SERVICE_URL=http://localhost:8001
EMAIL_SERVICE_URL=http://localhost:8003
LEAD_SERVICE_URL=http://localhost:8002
CONVERSION_SERVICE_URL=http://localhost:8004
GUMROAD_SERVICE_URL=http://localhost:8005
TRAFFIC_SERVICE_URL=http://localhost:8006

# Frontend Configuration (frontend/lib/api.ts reads these)
# NEXT_PUBLIC_API_URL        - funnel API. Express backend is :3001 in
#   docker-compose; the python orchestrator is host-mapped to :18000.
# NEXT_PUBLIC_EMPIRE_API_URL - empire_os engine API (:8100).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_EMPIRE_API_URL=http://localhost:8100
